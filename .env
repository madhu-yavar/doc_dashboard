# Frontend API URL
VITE_API_URL=http://127.0.0.1:8001

# Gemma Configuration (for extraction agents)
GEMMA_URL=http://206.1.62.28:8000/v1/chat/completions
GEMMA_MODEL=gemma-4-26B-A4B-it

# Gemma Fallback Configuration (alternative endpoint or model)
# Falls back to this model if primary model fails or times out
GEMMA_ENABLE_FALLBACK=false
GEMMA_FALLBACK_URL=http://206.1.62.28:8000/v1/chat/completions
GEMMA_FALLBACK_MODEL=gemma-4-26B-A4B-it

# Increase timeout for Gemma 4-26B (slower model, needs more time)
EXTRACTION_GEMMA_TIMEOUT_MS=600000
GEMMA_TIMEOUT_MS=600000

# Text budget for 16384 token limit (Gemma 4-26B-A4B strict constraint)
# Maximum reduction for very large PDFs
# Token budget allocation:
# - PDF text: ~4000 tokens (16000 chars) - minimal context
# - Template: ~3000 tokens
# - Output: ~4000 tokens
# - Total: ~11000 tokens (safe margin under 16384 limit)
EXTRACTION_TEXT_BUDGET=16000
CLINICAL_EXTRACTION_TEXT_BUDGET=15000

# Max output tokens per request (increased for better detail extraction)
EXTRACTION_MAX_OUTPUT_TOKENS=4000

# ============================================
# STT BACKEND CONFIGURATION
# ============================================

# STT Backend: "medasr", "whisper", or "gemini"
# medasr = Medical ASR (best for medical dictation)
# whisper = self-hosted Whisper at WHISPER_STT_URL
# gemini = Google Gemini API
# Fallback chain: medASR → Whisper → Gemini
STT_BACKEND=medasr

# Hybrid Mode: Run MedASR + Whisper in parallel, reconcile with Gemma
# ENABLE_HYBRID_STT=true enables the hybrid reconciliation approach
# This produces higher quality transcripts but takes longer (~15-25s total)
ENABLE_HYBRID_STT=true

# Hybrid Reconciler Timeout - How long to wait for Gemma LLM reconciliation
# Set to 240s (4 minutes) to allow sufficient time for LLM processing while staying under nginx 300s timeout
HYBRID_RECONCILER_TIMEOUT=240000

# medASR Configuration (Medical ASR - optimized for clinical dictation)
MEDASR_ENDPOINT=http://206.1.62.28:8008/transcribe
MEDASR_TIMEOUT=30000
MEDASR_MAX_RETRIES=2

# Whisper Self-Hosted Configuration
WHISPER_STT_URL=http://202.88.209.11/whisper/transcribe
WHISPER_LANGUAGE=auto
WHISPER_TEMPERATURE=0

# Live Conversation Debug
LIVE_CONVERSATION_DEBUG=true

# Silero VAD Model (for future streaming/voice activity detection)
VAD_MODEL_PATH=./models/silero_vad_v4.onnx

# Gemini Configuration (for external knowledge and Stage 3 handwriting extraction)

GEMINI_API_KEY=AIzaSyB7id4gzU0DUBq0xba-y-1U_9oOjLHHTRI
GEMINI_API_KEY_FALLBACK=AIzaSyDm4_iDDAlP_DBbmxDkskozho2W5iLzzPA
GEMINI_MODEL=gemini-3.1-flash-lite-preview

# Fallback models (tried in order if primary fails):
GEMINI_MODEL_FALLBACK_1=gemini-3.1-pro-preview
GEMINI_MODEL_FALLBACK_2=gemini-2.5-pro
GEMINI_MODEL_FALLBACK_3=gemini-2.5-flash

# Alternative models (uncomment to use):
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash-exp
# GEMINI_MODEL=gemini-2.0-flash-exp
# GEMINI_MODEL=gemini-1.5-pro
# GEMINI_MODEL=gemini-1.5-flash

# Enable agentic classification
USE_AGENTIC_CLASSIFICATION=true

# Feature Flags
ENABLE_TWO_STAGE_EXTRACTION=true
ENABLE_PHI_MASKING=true
HANDWRITING_THRESHOLD=15

