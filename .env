# Frontend API URL
VITE_API_URL=http://localhost:8001

# Gemma Configuration (for extraction agents)
GEMMA_URL=http://206.1.62.28:8000/v1/chat/completions
GEMMA_MODEL=google/gemma-4-31B-it

# Increase timeout for Gemma 4-31B (slower model, needs more time)
EXTRACTION_GEMMA_TIMEOUT_MS=600000
GEMMA_TIMEOUT_MS=600000

# Optimized text budget for 16384 token limit (Gemma 4-31B constraint)
# 30% reduction from original - maintains high quality while staying within limits
# Token budget allocation:
# - PDF text: ~7000 tokens (28000 chars)
# - Template: ~2500 tokens
# - Output: ~2000 tokens
# - Total: ~11500 tokens (safe margin under 16384)
EXTRACTION_TEXT_BUDGET=28000
CLINICAL_EXTRACTION_TEXT_BUDGET=16800

# Max output tokens per request (reduced to stay within budget)
EXTRACTION_MAX_OUTPUT_TOKENS=2000

# Gemini Configuration (for external knowledge and Stage 3 handwriting extraction)

GEMINI_API_KEY=AIzaSyB7id4gzU0DUBq0xba-y-1U_9oOjLHHTRI
GEMINI_MODEL=gemini-2.5-pro

# Alternative models (uncomment to use):
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash-exp
# GEMINI_MODEL=gemini-2.0-flash-exp
# GEMINI_MODEL=gemini-1.5-pro
# GEMINI_MODEL=gemini-1.5-flash

# Enable agentic classification
USE_AGENTIC_CLASSIFICATION=true

# Feature Flags
ENABLE_TWO_STAGE_EXTRACTION=true
ENABLE_PHI_MASKING=true
HANDWRITING_THRESHOLD=15

# ============================================
# PHARMACY ALERT CONFIGURATION
# ============================================

# Enable/disable pharmacy alerts (set to "false" to disable)
PHARMACY_ALERTS_ENABLED=true

# Email Configuration (MOCK MODE - no actual emails sent)
SEND_PHARMACY_EMAIL=true
# SendGrid is in mock mode - emails are logged to console only
# To enable real emails: get API key from https://sendgrid.com/
SENDGRID_API_KEY=
PHARMACY_EMAIL_FROM=notifications@doctor-dashboard.com
PHARMACY_EMAIL_TEAM=pharmacy@hospital.com
PHARMACY_EMAIL_REPLY_TO=

# WhatsApp Configuration (MOCK MODE - no actual messages sent)
SEND_PHARMACY_WHATSAPP=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
PHARMACY_WHATSAPP_PHONE_NUMBER=

# Alert Logging
PHARMACY_ALERT_LOG_PATH=./server/storage/pharmacy_alerts.jsonl

# Set to "false" to actually send emails (requires valid SendGrid API key)
PHARMACY_ALERT_LOG_ONLY=true

# Dashboard URL for links in alerts
DASHBOARD_BASE_URL=http://localhost:8001

# ============================================
# DEPARTMENT ALERTS CONFIGURATION
# ============================================

# Enable/disable department alerts (Lab, Radiology, Nuclear Medicine, Procedures)
DEPARTMENT_ALERTS_ENABLED=true

# Department Email Configuration (MOCK MODE)
# Emails are logged to console only - not actually sent
LAB_EMAIL=lab@hospital.com
RADIOLOGY_EMAIL=radiology@hospital.com
NUCLEAR_MEDICINE_EMAIL=nuclear@hospital.com
PROCEDURES_EMAIL=procedures@hospital.com

# Alert Logging
DEPARTMENT_ALERT_LOG_PATH=./server/storage/department_alerts.jsonl

# Set to "false" to actually send emails (requires email service configuration)
DEPARTMENT_ALERT_LOG_ONLY=true
