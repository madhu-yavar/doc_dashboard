# ============================================
# PHASE 2A DUAL-WRITE CONFIGURATION
# ============================================

# Phase 2A Dual-Write (Postgres shadow writes)
ENABLE_DUAL_WRITE_PHASE_2A=true

# ============================================
# PHASE 4 READ CUTOVER CONFIGURATION
# ============================================

# Subsystem-specific read flags for PostgreSQL cutover
# All flags default to false - legacy filesystem/SQLite reads are used when false
# When enabled, reads are served from PostgreSQL repositories

# Enable auth reads from users/auth_sessions Postgres tables
ENABLE_PG_READ_AUTH=false

# Enable document reads from documents Postgres table
ENABLE_PG_READ_DOCUMENTS=false

# Enable voice transcript/review reads from Postgres tables
ENABLE_PG_READ_VOICE=false

# Enable live conversation reads from Postgres tables
ENABLE_PG_READ_LIVE=false

# Enable chat reads from Postgres tables
ENABLE_PG_READ_CHAT=false

# Enable audit reads from Postgres tables
ENABLE_PG_READ_AUDIT=false

# Enable alert reads from Postgres tables
ENABLE_PG_READ_ALERTS=false

# Enable analytics reads from Postgres tables
ENABLE_PG_READ_ANALYTICS=false

# Whisper STT Configuration (needed for webm/mp4 browser recordings)
WHISPER_STT_URL=http://206.1.62.28:8008/transcribe
WHISPER_LANGUAGE=en
WHISPER_TEMPERATURE=0


# Pyannote Speaker Diarization Configuration
PYANNOTE_PYTHON_BIN=.venv-pyannote/bin/python3.11
PYANNOTE_MODEL_DIR=models/pyannote-speaker-diarization-community-1
PYANNOTE_DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
PYANNOTE_DEVICE=cpu
PYANNOTE_TIMEOUT=600000
PYANNOTE_WINDOW_SECONDS=180
PYANNOTE_WINDOW_OVERLAP_SECONDS=15
SPEAKER_DIARIZATION_PROVIDER=pyannote
SPEAKER_DIARIZATION_ALLOW_FALLBACK=true


# Live Conversation Transcription and Extraction
ENABLE_LIVE_TRANSCRIPTION=false
ENABLE_LIVE_DRAFT_EXTRACTION=true
