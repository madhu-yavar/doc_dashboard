# PostgreSQL Configuration for Doctor Dashboard
# Copy this file to .env and update with your actual credentials

# PostgreSQL Connection Settings
PGHOST=localhost
PGPORT=5432
PGDATABASE=doctor_dashboard
PGUSER=postgres
PGPASSWORD=your_password_here

# Connection Pool Settings
PGPOOL_MAX=20
PGIDLE_TIMEOUT=30000
PGCONNECTION_TIMEOUT=2000